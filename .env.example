# Google Gemini API (AI issue classification & chat assistant)
GEMINI_API_KEY=

# Supabase Postgres — use the CONNECTION POOLER string (port 6543), not
# the direct connection (port 5432). Get this from Supabase Dashboard →
# Project Settings → Database → Connection Pooling.
DATABASE_URL=

# Optional fallback: direct Postgres connection string (port 5432).
# Used by server/db.ts only when DATABASE_URL is not set.
DIRECT_URL=

# Supabase client config (used by src/lib/supabase.ts) — from Supabase
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: live Pakistan news for the News & Civic Digest feature
NEWS_API_KEY=
